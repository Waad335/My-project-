# ---------------------------------------------------------------------------
# VELOURA — environment configuration
# Copy this file to `.env.local` and fill in real values.
# See README.md → "Connecting Shopify" for where to find these.
# ---------------------------------------------------------------------------

# Your Shopify store's domain, e.g. veloura.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront API access token from a custom app with unauthenticated
# Storefront API access scopes. Server-only — never exposed to the client.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional — used to generate absolute URLs in metadata, sitemap.xml, and JSON-LD.
# Set this to your production domain once connected (e.g. https://veloura.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
