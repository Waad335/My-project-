# Copy to .env (git-ignored) and adjust.
#
# The ONLY variable the app reads. It is bundled into the app and therefore
# public: put a server address here, never a password, key or token.
#
# Point it at a website server running on your computer with a LOCAL
# database (npm run build && npm start in the repository root). On a phone,
# use your computer's network address, e.g. http://192.168.1.20:3000 —
# "localhost" on a phone is the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:3000
