{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      // The only website files the app may use (see __tests__/shared-imports.test.ts).
      "@shared/messages/en.json": ["../src/messages/en.json"],
      "@shared/messages/ar.json": ["../src/messages/ar.json"],
      "@shared/api-types": ["../src/lib/mobile/types.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
