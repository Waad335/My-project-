# ---------------------------------------------------------------------------
# DODANA — environment variables
# Copy this file to .env (local dev) or configure the same keys in your
# hosting provider's dashboard (Vercel/Render/etc.) for production.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (self-hosted Postgres or a managed provider
# such as Supabase — use the "connection pooling" URI Supabase gives you for
# serverless hosting, and the direct URI for migrations if they differ).
DATABASE_URL="postgresql://dodana:dodana@localhost:5432/dodana?schema=public"

# NextAuth (admin dashboard authentication)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for metadata, sitemap, absolute links, webhooks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Paymob (recommended payment gateway for Egypt — see README "Payments"
# section for exactly what to request from Paymob when you open the account).
# Leave these unset to keep online payment disabled; Cash on Delivery keeps
# working with no payment gateway at all.
# ---------------------------------------------------------------------------
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
# Integration ID for the "Online Card" payment integration in Paymob's dashboard
PAYMOB_CARD_INTEGRATION_ID=""
# Integration ID for the "Mobile Wallet" payment integration (Vodafone Cash, etc.)
PAYMOB_WALLET_INTEGRATION_ID=""
# iFrame ID shown in Paymob dashboard > Developers > iFrames
PAYMOB_IFRAME_ID=""

# Default WhatsApp ordering number (E.164 without "+", e.g. 201234567890).
# This is also editable at runtime from Admin > Settings; this env var is only
# the seed/fallback value.
WHATSAPP_NUMBER="201000000000"

# First admin account, created by `npm run db:seed`. Change the password
# immediately after first login.
ADMIN_EMAIL="admin@dodana.com"
ADMIN_PASSWORD="ChangeMe123!"
