# ---------------------------------------------------------------------------
# DODANA — environment variables
# Copy this file to .env (local dev) or configure the same keys in your
# hosting provider's dashboard (Vercel/Render/etc.) for production.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Locally this points at the sandbox's own
# Postgres (schema=public). In production this points at the existing
# Supabase project's Postgres, with DODANA's own isolated schema:
#   postgresql://postgres:[DB-PASSWORD]@[HOST]:[PORT]/postgres?schema=dodana
# Use the "Connection pooling" URI from Supabase (Project Settings > Database
# > Connection string) for serverless hosting like Vercel. The `?schema=`
# parameter is what confines every query to the `dodana` schema — verified
# working against a real Postgres instance; no other Prisma config needed.
DATABASE_URL="postgresql://dodana:dodana@localhost:5432/dodana?schema=public"

# NextAuth (admin dashboard authentication)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for metadata, sitemap, absolute links, webhooks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase Storage (persistent product image uploads).
# Leave unset for local dev — uploads then fall back to /public/uploads.
# In production, these are required: see README "Supabase Storage".
# Get these from your Supabase project > Settings > API.
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key (NOT the anon key —
#                                and never expose this one to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Name of the *public* Storage bucket to upload product images into.
SUPABASE_STORAGE_BUCKET="product-images"

# ---------------------------------------------------------------------------
# Paymob (recommended payment gateway for Egypt — see README "Payments"
# section for exactly what to request from Paymob when you open the account).
# Leave these unset to keep online payment disabled; Cash on Delivery keeps
# working with no payment gateway at all.
# ---------------------------------------------------------------------------
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
# Integration ID for the "Online Card" payment integration in Paymob's dashboard
PAYMOB_CARD_INTEGRATION_ID=""
# Integration ID for the "Mobile Wallet" payment integration (Vodafone Cash, etc.)
PAYMOB_WALLET_INTEGRATION_ID=""
# iFrame ID shown in Paymob dashboard > Developers > iFrames
PAYMOB_IFRAME_ID=""

# ---------------------------------------------------------------------------
# Instagram product import (official "Instagram API with Instagram Login").
# Leave these unset to keep the feature disabled — admin sees a clear
# "not configured" message instead of a broken Connect button. No scraping
# is used anywhere; this is Meta's documented OAuth + Graph API flow for
# Instagram Professional (Business/Creator) accounts.
#
# To create these values:
#   1. Go to https://developers.facebook.com/apps and create an app
#      (type: "Other" > "Consumer", or "Business").
#   2. Add the "Instagram" product ("Instagram API with Instagram Login").
#   3. Under Instagram > API setup, note the Instagram app ID and secret.
#   4. Add an OAuth redirect URI pointing at your deployed admin route:
#        https://YOUR-DOMAIN/api/admin/instagram/callback
#   5. Connect the @dodana.girls Instagram Professional account to the app
#      as an "Instagram tester" (or publish the app) so it can authorize.
# These are server-only secrets — never exposed to the browser.
# ---------------------------------------------------------------------------
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Must exactly match a redirect URI configured on the Meta app, e.g.:
#   https://your-domain.com/api/admin/instagram/callback
INSTAGRAM_REDIRECT_URI=""

# Default WhatsApp ordering number (E.164 without "+", e.g. 201234567890).
# This is also editable at runtime from Admin > Settings; this env var is only
# the seed/fallback value.
WHATSAPP_NUMBER="201000000000"

# First admin account, only used if/when you run `npm run db:seed`.
# Not required otherwise — the production `dodana.admin_users` table can
# instead be given a single admin row directly (one SQL statement, your
# call on when), without running the full seed script or its demo data.
ADMIN_EMAIL="admin@dodana.com"
ADMIN_PASSWORD="ChangeMe123!"
